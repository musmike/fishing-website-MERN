{
  "openapi": "3.0.3",
  "info": {
    "title": "Fishing Website API (MERN)",
    "description": "Interactive REST API documentation for the Fishing Website (MERN stack: MongoDB, Express.js, React, Node.js). Supports JWT Bearer authorization and API key auth (x-access-token).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local / Docker backend server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "User registration and authentication"
    },
    {
      "name": "Posts",
      "description": "Blog posts and fishing articles"
    },
    {
      "name": "Reviews",
      "description": "Customer reviews and store opinions"
    },
    {
      "name": "User",
      "description": "User profile management"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user account",
        "description": "Creates a new user account with first name, last name, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Pomyślnie utworzono użytkownika" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Pole Imię jest wymagane!" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Użytkownik o podanym adresie email istnieje!" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user and receive a JWT token",
        "description": "Validates email and password, returns a signed JWT token on success.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Pole Email jest wymagane!" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Nieprawidłowy adres email!" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "Retrieve paginated blog posts",
        "description": "Fetches blog posts in reverse chronological order with pagination (4 per page).",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (defaults to 1)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of blog posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Post"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/post/{id}": {
      "get": {
        "tags": ["Posts"],
        "summary": "Retrieve a single blog post by ID",
        "description": "Returns full details of a specific blog post.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectID of the post",
            "schema": {
              "type": "string",
              "example": "666d90b70b8dd2ed3af6dc9d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "404": {
            "description": "Post not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Wpis nie został znaleziony" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "Retrieve all customer reviews",
        "description": "Fetches all store reviews with populated author details, sorted by update date descending.",
        "responses": {
          "200": {
            "description": "List of reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/review": {
      "post": {
        "tags": ["Reviews"],
        "summary": "Create a new customer review",
        "description": "Creates a store review authored by the currently authenticated user.",
        "security": [
          { "bearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Pomyślnie utworzono opinię." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / invalid token"
          },
          "403": {
            "description": "Forbidden - no token provided"
          }
        }
      }
    },
    "/api/review/{id}": {
      "patch": {
        "tags": ["Reviews"],
        "summary": "Update an existing review",
        "description": "Updates review content. Only the author or an admin user can edit.",
        "security": [
          { "bearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectID of the review",
            "schema": {
              "type": "string",
              "example": "666f05c5dca1fa322a02fe4a"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "403": {
            "description": "Access denied - not author and not admin"
          },
          "404": {
            "description": "Review not found"
          }
        }
      },
      "delete": {
        "tags": ["Reviews"],
        "summary": "Delete a review",
        "description": "Deletes a review. Only the author or an admin user can delete.",
        "security": [
          { "bearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectID of the review",
            "schema": {
              "type": "string",
              "example": "666f05c5dca1fa322a02fe4a"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Usunięto opinię." }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Access denied - not author and not admin"
          },
          "404": {
            "description": "Review not found"
          }
        }
      }
    },
    "/api/user": {
      "patch": {
        "tags": ["User"],
        "summary": "Update user profile or change password",
        "description": "Updates first name, last name, email, or password for the authenticated user.",
        "security": [
          { "bearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Dane użytkownika zaktualizowane pomyślnie." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or wrong current password"
          },
          "409": {
            "description": "Email already in use"
          }
        }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Delete authenticated user account",
        "description": "Permanently deletes the account of the currently logged-in user.",
        "security": [
          { "bearerAuth": [] },
          { "ApiKeyAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "User account deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Konto usunięte pomyślnie" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token (paste only the raw token string, without 'Bearer ' prefix; Swagger UI adds 'Bearer ' automatically)"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-access-token",
        "description": "Enter your JWT token in x-access-token header"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "password"],
        "properties": {
          "firstName": { "type": "string", "example": "Jan" },
          "lastName": { "type": "string", "example": "Kowalski" },
          "email": { "type": "string", "format": "email", "example": "jan.kowalski@example.com" },
          "password": { "type": "string", "format": "password", "example": "User123!" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "admin@wp.pl" },
          "password": { "type": "string", "format": "password", "example": "Admin123!" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "string", "description": "Signed JWT token" },
          "message": { "type": "string", "example": "Zalogowano pomyślnie." }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "666d90b70b8dd2ed3af6dc9d" },
          "title": { "type": "string", "example": "Najlepsze miejsca na wędkowanie" },
          "short_description": { "type": "string", "example": "Odkryj najlepsze miejsca na spokojne wędkowanie." },
          "content": { "type": "string", "example": "Dziś rano wstałem przed świtem..." },
          "author": { "type": "string", "example": "Michał Muzyka" },
          "image_link": { "type": "string", "example": "https://d1l57x9nwbbkz.cloudfront.net/files/s3fs-public/2022-01/fishing-beginners%20in%20Ontario.jpg" },
          "created_at": { "type": "string", "example": "2021-10-12 13:24:53" }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "666f05c5dca1fa322a02fe4a" },
          "author": {
            "type": "object",
            "properties": {
              "_id": { "type": "string", "example": "666dabc152c685d02114826a" },
              "firstName": { "type": "string", "example": "Michał" },
              "lastName": { "type": "string", "example": "Adminowski" }
            }
          },
          "content": { "type": "string", "example": "Super sklep wędkarski. Bardzo szeroki wybór wędzisk i kołowrotków!" },
          "created_at": { "type": "string", "example": "2024-06-16T15:33:25.031Z" },
          "updated_at": { "type": "string", "example": "2024-06-17T11:29:56.536Z" }
        }
      },
      "CreateReviewRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "example": "Świetna obsługa i doradztwo w doborze wędki spinningowej!" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string", "example": "Jan" },
          "lastName": { "type": "string", "example": "Kowalski" },
          "email": { "type": "string", "format": "email", "example": "jan.nowy@example.com" },
          "currentPassword": { "type": "string", "format": "password", "example": "User123!" },
          "newPassword": { "type": "string", "format": "password", "example": "NewPassword123!" },
          "confirmNewPassword": { "type": "string", "format": "password", "example": "NewPassword123!" }
        }
      }
    }
  }
}
